OPENAI_API_KEY=sk-your-key-here
TWILIO_STREAM_URL=wss://your-public-host:8766
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WS_PORT=8766
TWILIO_STREAM_TOKEN_SECRET=
TWILIO_MAX_SESSIONS=8
# Set to true only behind a trusted proxy that overwrites X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false
$EXTRA_ENV_VARS
